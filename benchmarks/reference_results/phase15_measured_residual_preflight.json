{
 "schema": "clifford_qc.phase15_measured_residual_preflight.v1",
 "config_path": "benchmarks/configs/phase15_measured_residual_preflight.json",
 "config_digest": "b9b2eb38bb769d4b5e5e5454106f257264ee785df05a2a477beea38f410054aa",
 "claim_boundary": "This record reports the one measured-residual cost preflight benchmarks/configs/phase15_measured_residual_preflight.json froze. On each of the five licensed banks it records, under each declared grouping protocol, the single-assignment QWC settings and one-shot linearized variances of the ground Ritz root's energy and residual-norm estimators, their ratio R at one matched standard error, the status the frozen ladder gives, and the verdict. The ratios are first-order and asymptotic, read from exact reference variances with uniform shots per setting. They say nothing about finite-sample intervals, device time, other groupings or allocations, or any bank outside the five.",
 "preregistration": {
  "gate": "benchmarks/check_phase15_measured_residual_preregistration.py",
  "revision": 1,
  "config_claim_boundary_at_landing": "This config declares the Phase 15 measured-residual cost preflight: on the five banks the H-squared preflight licensed, the ratio of the asymptotic shots that estimate the ground Ritz root's residual norm to those that estimate its energy, at one matched standard error, under single-assignment QWC grouping with uniform shots per setting. It holds no ratio, no residual functional, no grouping of a combined word universe and no group variance. The ratio it declares is first-order and asymptotic, read from exact reference variances: it is not a finite-sample statement, a coverage claim, a device time, or a statement about any bank outside the five."
 },
 "quantum_advantage_claim": false,
 "evidence": {
  "label": "asymptotic",
  "statement": "First-order (delta-method) variances at large shot counts, computed exactly from the reference state and the frozen bases. No sampling, no seed beyond the finite-difference direction, no finite-sample statement."
 },
 "statistic": {
  "name": "R",
  "definition": "R = (G_U * V_sigma2) / (4 * sigma^2 * G_SH * V_E)",
  "derivation": "Uniform shots make a linearized estimator's variance V / N at N shots per setting, so a standard error s costs G * V / s^2 shots. sigma is read from sigma^2 through d sigma = d sigma^2 / (2 sigma). Matching the two standard errors at s, the s^2 cancels: R is the residual's shots over the energy's at any one matched precision, to first order",
  "max_ratio": 10,
  "rationale": "A decade is the unit this repository reads as material, as in Q16's word clause and Phase 16B's 10x modelled-shot rule. A residual within a decade of its energy's shots is a by-product of measuring that energy well; beyond it, it is a measurement of its own. A ratio exactly at ten is affordable",
  "matched_precision": "Matching the standard errors of E and sigma makes both ends of the measured Weinstein interval [E - sigma, E + sigma] carry the two sources equally",
  "linear_regime": "d sigma = d sigma^2 / (2 sigma) holds while the standard error of sigma^2 is small against sigma^2. At a matched precision s that error is 2 sigma s, so the record reports matched_precision_half = sigma / 4, the s at which it reaches one half of sigma^2. Finer precisions are where R describes the cost; coarser ones do not resolve sigma from zero. No clause reads it",
  "diagnostics": "the record also reports the Neyman ratio, both sides at variance-optimal allocation across settings, (sum_g sqrt v_g)^2 in place of G * V. No clause reads it"
 },
 "grouping": {
  "estimator": "single_assignment",
  "allocation": "uniform",
  "energy_universe": "the measured (S, H) universe: the raw U_SH, the (S, H) bank's words over the retained block, minus the identity, listed in ascending code order exactly as the mapping-axis producer lists its JW arm",
  "residual_universe": "the measured combined universe: the raw U = U_SH | U_K minus the identity. The raw U is every word a measured second-moment bank's rows carry, and the H-squared preflight record committed its size and SHA-256",
  "universe_convention": "Raw universes include the identity, as the Phase 2M-A ledger, the H-squared preflight record and the mapping-axis record count and hash them; every frozen basis starts with I, so S_00 carries it. Measured universes are the raw ones minus the identity, whose mean is 1 and is never measured. Every count and digest in measured_before_freezing whose name starts with raw_ is a raw quantity; measured_sh_words and measured_combined_words are one fewer, and every grouping partitions a measured universe",
  "declared_protocol_by_system": {
   "h4": "qwc_groups",
   "h4_converged": "qwc_groups",
   "beh2": "qwc_groups",
   "h2o_cas8e6o": "qwc_basis_cover",
   "hubbard_2x2": "qwc_groups"
  },
  "alternative_protocol_by_system": {
   "h4": "qwc_basis_cover",
   "h4_converged": "qwc_basis_cover",
   "beh2": "qwc_basis_cover",
   "h2o_cas8e6o": null,
   "hubbard_2x2": "qwc_basis_cover"
  },
  "rationale": "The declared protocol is the mapping-axis record's, per system, so the energy denominator reproduces a committed setting count. On the 8-qubit banks the greedy and the scalable cover are both feasible, and a status must not rest on one heuristic. On H2O the greedy is quadratic in 868,150 words, so the cover is the only protocol and no alternative is declared",
  "variance": "per setting, Var_psi(sum_{w in g} f_w P_w) on the exact reference, by run_mapping_axis._functional_variance, the function behind the committed mapping-axis energy variances. V is their sum: the estimator's variance at one shot per setting"
 },
 "finite_difference": {
  "directions": [
   "functional",
   "sh_gaussian"
  ],
  "direction_definitions": {
   "functional": "the residual functional's own non-identity weights, normalized to unit length: the derivative along it is ||g||_2",
   "sh_gaussian": "a seeded standard normal draw over the non-identity (S, H) words, normalized: those words carry the Ritz-vector term"
  },
  "seed": 20261003,
  "step": 0.001,
  "relative_tolerance": 1e-06,
  "rounding_floor": "RESOLUTION * cancellation_scale / step, with RESOLUTION = 1e-12 from clifford_qc.subspace.second_moment and the cancellation scale the validation record's",
  "rule": "|central difference of the nonlinear pipeline - g . d| <= relative_tolerance * ||g||_2 + rounding_floor, for both directions",
  "calibration": "On the undeclared Hubbard dimer the step leaves the truncation error near 5e-9 of ||g||_2, with and without a -75 Ha constant added to H to reproduce H2O's cancellation scale. A dropped Ritz-vector term fails it by orders of magnitude"
 },
