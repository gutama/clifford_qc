  "estimand": {
    "asymmetric_limitation": "Failure to separate cannot establish the opposite QR3 direction because R3d targets R3c's point-support cells rather than refining all 187 cells entering the global extrema. Every non-separating outcome is indeterminate_after_refinement.",
    "directional_scope": "A strict separation establishes that a mapping spread is larger than an instance spread on these preregistered supports and therefore establishes the positive QR3 direction within the frozen two-instance exact-tier boundary.",
    "evidence_tier": "exact",
    "evidence_tier_basis": "Oracle-reference benchmark comparison with heuristic Monte Carlo search uncertainty; not a finite-sample energy certificate, device-noise simulation, or hardware result.",
    "name": "qr3_direction_on_preregistered_r3c_point_support",
    "question": "After adding only the frozen geometric midpoints inside the inherited conservative intervals, is the minimum possible mapping spread on R3c's widest point-support cell strictly greater than the maximum possible instance spread on R3c's narrowest point-support cell?"
  },
  "evidence_role": "targeted_accuracy_matched_cost_refinement",
  "evidence_tier": "exact",
