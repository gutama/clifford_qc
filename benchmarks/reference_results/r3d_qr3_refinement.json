  "future_readout_contract": {
    "global_extrema_may_not_be_reselected_after_r3d": true,
    "instance_support_maximum_formula": "max(instance-cell upper costs) / min(instance-cell lower costs)",
    "mapping_support_minimum_formula": "max(mapping-cell lower costs) / min(mapping-cell upper costs), clamped below at 1",
    "negative_readout_allowed": false,
    "otherwise": "indeterminate_after_refinement, including overlap, equality, marginal-only non-resolution, missing evidence, nonmonotonicity, or an invalid interval",
    "point_estimates_are_decisive": false,
    "positive": "qr3_mapping_spread_larger_on_preregistered_support, if and only if both supports are valid and mapping_support_minimum is strictly greater than instance_support_maximum"
  },
