{
 "schema": "clifford_qc.phase15_variance_extrapolation.v1",
 "config_path": "benchmarks/configs/phase15_variance_extrapolation.json",
 "config_digest": "4b553d9d1ad53a88f1a483c8b188e2192c922cdaa9c8004aa88188f901c54c91",
 "claim_boundary": "This record reports the one variance-extrapolation test benchmarks/configs/phase15_variance_extrapolation.json froze. On each frozen mapping-axis basis, it records the prefix trajectory of exact Ritz ground energies and variances, a straight line through its last three points read at zero variance, and that value's error against the exact sector ground energy beside the final Ritz energy's. The verdict reads the banks inside the declared domain only. It judges the rule on exact inputs; it says nothing about finite-shot variances, other windows, or bases outside the five.",
 "preregistration": {
  "gate": "benchmarks/check_phase15_extrapolation_preregistration.py",
  "revision": 1,
  "config_claim_boundary_at_landing": "This config declares the Phase 15 variance-extrapolation test: on each frozen mapping-axis basis in its domain, whether a straight line through the last three points of the prefix trajectory (sigma^2_M, E_M), read at sigma^2 = 0, at least halves the final Ritz energy's error against the exact sector ground energy. It holds no prefix variance, fit or extrapolated energy. The verdict reads exact energies no device run has, so it tests the rule, not a measured estimator; it prices no shots and bounds no basis outside the declared ones."
 },
 "quantum_advantage_claim": false,
 "evidence": {
  "label": "exact_oracle",
  "statement": "Exact Ritz energies and variances, judged against exact sector energies. No sampling."
 },
 "fit": {
  "window": 3,
  "window_points": "the last three prefixes, M_f - 2, M_f - 1 and M_f",
  "model": "ordinary least squares E = a + b sigma^2 over the window; the extrapolated energy is a",
  "extrapolable_when": "every window variance is resolved, the window variances are distinguishable (their spread exceeds the SecondMomentBank resolution, 1e-12, times the largest cancellation scale among them), and b > 0",
  "rationale": "Near convergence, with one dominant excited contamination of weight w, E - E_0 ~ w gap and sigma^2 ~ w gap^2, so E ~ E_0 + sigma^2/gap: a line whose intercept is E_0 and whose slope is positive. The last three prefixes are the most converged, where that holds best, and a third point leaves the line a residual to report. A non-positive slope contradicts the model, which is a legitimate outcome, not an error.",
  "improvement_factor": 0.5,
  "improvement_rationale": "An estimator that ships beside the Ritz energy should at least halve its error where it applies; anything less is not worth a second number with a weaker guarantee than the variational one.",
  "distinguishability_rationale": "Each variance carries rounding of about the resolution times its cancellation scale. A window whose spread is no larger has a slope made of rounding, and a line fitted to it extrapolates noise. That is the case when the last generators leave the Ritz state unchanged."
 },
 "domain": {
  "criterion": "sigma_f <= gap / 2, with sigma_f the final Ritz state's residual norm and gap = E_1 - E_0 of the exact (N, S_z) sector",
  "rationale": "The linear model assumes the Ritz state is close to the ground state. Temple's regime is the principled version: when the residual is below half the gap, the Ritz state is dominated by the ground state and the contamination picture holds. Outside it the model has no footing, and a bank there can only be a diagnostic.",
  "source_of_sigma_f": "benchmarks/reference_results/second_moment_validation.json, ground root of each bank"
 },
