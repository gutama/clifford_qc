{
 "schema": "clifford_qc.phase15_h2_preflight.v1",
 "config_path": "benchmarks/configs/phase15_h2_preflight.json",
 "config_digest": "f2bbccc80efa19f1c4b95aeabe0251e295a56263bd1a72b1976f94ac85f078e3",
 "claim_boundary": "This record reports the one preflight benchmarks/configs/phase15_h2_preflight.json froze: exact word and coefficient counts of the second-moment rows A_i^dagger (H^2 A_j) over the retained block of each of the five frozen mapping-axis banks, both clauses read at both pruning thresholds, and the verdict the frozen rule gives. The counts price the words a measured second-moment bank must estimate and the coefficients it must hold. They do not price grouping, shots, circuits, wall time or hardware, and they bound no bank outside the five.",
 "preregistration": {
  "gate": "benchmarks/check_phase15_preregistration.py",
  "revision": 0,
  "config_claim_boundary_at_landing": "This config declares the Phase 15 H-squared support/cost preflight: which of the five frozen mapping-axis banks may carry a measured second-moment bank, read from exact word and coefficient counts of A_i^dagger H^2 A_j over each retained block. It holds no count of any second-moment row. The counts it declares are structural: they price the words a measured bank must estimate and the coefficients it must hold, not shots, grouping, circuits, wall time or hardware, and they bound nothing outside the five declared banks."
 },
 "quantum_advantage_claim": false,
 "evidence": {
  "label": "structural",
  "statement": "Exact integer counts of words and stored coefficients from exact multivector products. No sampling, no estimator, no seed."
 },
 "clauses": {
  "word": {
   "statistic": "|U_SH | U_K| / |U_SH|",
   "max_ratio": 10,
   "rationale": "A decade is the unit this repository reads as material, as in Phase 16B's 10x modelled-shot rule. Second moments that stay within one decade of the words the bank already measures extend an existing measurement; beyond it they are a different measurement. The ratio is of integers and is compared exactly."
  },
  "storage": {
   "statistic": "T_SH + T_K, resident coefficient occurrences over the block",
   "max_coefficient_occurrences": 96107619,
   "anchor_record": "beh2_stretched_results.json",
   "rationale": "The largest coefficient count any committed run has held: the stretched-BeH2 M = 31 bank, recovered exactly as cached_operator_bytes / 24 in the Phase 2M-A ledger, which completed at 10.75 GiB peak RSS on the object backend. A bank at or below it is one the package has demonstrably carried; above it, full construction waits for the Phase 2M storage gate, as PLAN.md already requires."
  }
 },
 "pruning": {
  "declared_tolerance": 1e-12,
  "strict_tolerance": 1e-09,
  "rule": "Both clauses are evaluated with the product's own pruning and again with every coefficient of magnitude at most 1e-9 removed from H2 and from each K row. The arithmetic is pure-Python IEEE float in a fixed order, so the counts are reproducible, but a word whose coefficient is rounding residue from an exact cancellation can sit just above 1e-12. Strict pruning only removes words, so it can only turn a failing clause into a passing one. A bank whose status differs between the two is CONVENTION_SENSITIVE and is not eligible.",
  "why_1e-9": "Three decades above the product's threshold, and below every declared Hamiltonian's smallest coefficient (2.05e-4 on H2O), so it cannot remove a Hamiltonian word."
 },
 "row_definition": {
  "hamiltonian_square": "H2 = H * H, formed once by the multivector product from the bank's own Hamiltonian (MatrixElementBank.hamiltonian), identity term included",
  "row": "K_ij = A_i.dagger() * (H2 * A_j), for i <= j over the frozen basis, in that product order: the second-moment analogue of MatrixElementBank._build_pair's A_i^dagger (H A_j)",
  "support": "the keys of the row's multivector after the product's own pruning, |c| > 1e-12",
  "pairs": "the retained block only: every i <= j over the frozen selected basis, M(M + 1)/2 rows. A Ritz residual norm reads the Ritz vector's block and nothing else, so rejected-candidate rows are outside the question.",
  "universes": "U_SH is the (S, H) bank's word universe over the same block, U_K the union of the K rows' supports, and the measured universe with second moments is U_SH | U_K."
 },
 "dense_tolerance": 1e-08,
